# Copiar a .env (no se versiona) y cambiar la clave
MQTT_USER=asistente
MQTT_PASS=cambia-esta-clave

# Solo si la Pi ya tiene otro Home Assistant/Mosquitto (proyecto de grado): descomentar
# COMPOSE_FILE=docker-compose.pi-compartida.yml
# COMPOSE_PROJECT_NAME=asistente
# OLLAMA_MEM_LIMIT=3g
# OLLAMA_CPUS=1.5          # 4 con la fuente oficial de 27 W; 1.5 con cargador de celular

# go2rtc: URL real de cada cámara (UNA sola conexión por cámara; HA y vision leen de go2rtc)
ESP32_URL=http://192.168.1.35:81/stream
IPHONE_URL=http://USUARIO:CLAVE@192.168.1.34:8081/video

# Servicio vision (YOLO): lee los streams desde go2rtc, no directo de las cámaras
CAMARAS=camara1=http://go2rtc:1984/api/stream.mjpeg?src=camara1,iphone=http://go2rtc:1984/api/stream.mjpeg?src=iphone
# Cámaras que solo reportan presencia/brillo (usar camara1 cuando el ESP32 tenga el firmware FOMO)
SOLO_PRESENCIA=
VISION_INTERVALO=2
VISION_CPUS=1
VISION_HILOS=2

# PERFIL BAJO CONSUMO (cargador de celular, no la fuente oficial de 27 W):
#   VISION_INTERVALO=3  VISION_CPUS=0.5  VISION_HILOS=1  OLLAMA_CPUS=1  VENTANA_MEDIANA=3
#   y en el modelo "asistente": num_thread 1 (ver docs/DOCUMENTACION.md, sección alimentación)
